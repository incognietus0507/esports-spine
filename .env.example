# ---- Copy to .env and fill in. Never commit .env. ----

# === Pipeline behaviour ===
POLL_INTERVAL_MINUTES=15
MIN_PROFIT_MARGIN=0.30          # 30% — items below this are ignored
MAX_LISTINGS_PER_RUN=40        # politeness cap across all sources
CRAIGSLIST_REGION=sfbay        # e.g. sfbay, newyork, seattle
CRAIGSLIST_CATEGORIES=ata,vgc  # ata=antiques, vgc=video games (CL category codes)
SEARCH_TERMS=                  # optional comma-separated keyword filter

# === Profit model assumptions ===
EBAY_FEE_RATE=0.1335           # ~13.35% final value fee (category dependent)
EBAY_FIXED_FEE=0.30            # per-order fixed fee
SHIPPING_COST=12.00            # flat assumed outbound shipping
ACQUISITION_COST=8.00          # estimated gas/time to pick up an item

# NL margin-scheme VAT (margeregeling): VAT charged only on (resale-buy),
# extracted from within the margin. 0.0 disables it (US/default). NL: 0.21.
VAT_MARGIN_RATE=0.0

# === Netherlands tips ===
# - For eBay.de comps, set EBAY_MARKETPLACE_ID=EBAY_DE below.
# - For Marktplaats, supply an authorized feed loader (no scraping). See
#   STRATEGY-NL.md / COMPLIANCE.md.

# === eBay official API (https://developer.ebay.com) ===
# Leave blank to run in MOCK valuation mode.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production            # production | sandbox

# === Discogs (vinyl/CDs) — https://www.discogs.com/settings/developers ===
# Set VALUATION_SOURCE=discogs to value records via Discogs instead of eBay.
VALUATION_SOURCE=ebay          # ebay | discogs
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=RetailArbitrageTool/0.1 (+https://example.com/contact)
DISCOGS_CURRENCY=EUR

# === Alerting (enable one or more) ===
DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
