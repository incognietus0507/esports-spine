# ---- Copy to .env and fill in. Never commit .env. ----

# === Pipeline behaviour ===
POLL_INTERVAL_MINUTES=15
MIN_PROFIT_MARGIN=0.30          # 30% — items below this are ignored
MAX_LISTINGS_PER_RUN=40        # politeness cap across all sources
CRAIGSLIST_REGION=sfbay        # e.g. sfbay, newyork, seattle
CRAIGSLIST_CATEGORIES=ata,vgc  # ata=antiques, vgc=video games (CL category codes)
SEARCH_TERMS=                  # optional comma-separated keyword filter

# === Profit model assumptions ===
EBAY_FEE_RATE=0.1335           # ~13.35% final value fee (category dependent)
EBAY_FIXED_FEE=0.30            # per-order fixed fee
SHIPPING_COST=12.00            # flat assumed outbound shipping
ACQUISITION_COST=8.00          # estimated gas/time to pick up an item

# === eBay official API (https://developer.ebay.com) ===
# Leave blank to run in MOCK valuation mode.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production            # production | sandbox

# === Alerting (enable one or more) ===
DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
