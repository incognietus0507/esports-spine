# ---- Copy to .env and fill in. Never commit .env. ----
# Defaults are tuned for the NETHERLANDS (see STRATEGY-NL.md).

# === Pipeline behaviour ===
POLL_INTERVAL_MINUTES=15
MIN_PROFIT_MARGIN=0.30         # 30% — items below this are ignored
MAX_LISTINGS_PER_RUN=40        # politeness cap across all sources
SEARCH_TERMS=                  # optional comma-separated keyword filter

# Minimum valuation confidence (0..1) before alerting. Mock valuations have
# confidence 0.0 — set this to e.g. 0.2 in production so demo numbers never
# look like real signals.
MIN_COMP_CONFIDENCE=0.0

# === Marktplaats source (AUTHORIZED feed only — no scraping, see COMPLIANCE.md) ===
# Path to a local JSON file of listings you are permitted to use
# (official partner API export, business CSV→JSON, or manual saved-search notes).
# Format: [ {"title": "...", "price": "€ 1.250,00", "url": "https://...", "city": "..."} ]
MARKTPLAATS_FEED_FILE=

# Watchlist: one saved-search term per line (# comments). Doubles as your
# checklist of Marktplaats saved searches. See watchlist-vinyl.example.txt.
WATCHLIST_FILE=

# === Profit model assumptions (EUR) ===
EBAY_FEE_RATE=0.12             # eBay.de final value fee (category dependent)
EBAY_FIXED_FEE=0.35            # per-order fixed fee
SHIPPING_COST=6.95             # PostNL parcel within NL (DE ~13-16)
ACQUISITION_COST=3.00          # pickup cost — NL is dense, often near zero
CURRENCY_SYMBOL=€

# NL margin-scheme VAT (margeregeling): VAT charged only on (resale-buy),
# extracted from within the margin. Set 0.0 if you are under KOR / not
# VAT-registered; 0.21 when the margin scheme applies.
VAT_MARGIN_RATE=0.21

# === Valuation source ===
VALUATION_SOURCE=discogs       # discogs (vinyl/CDs) | ebay

# === Discogs (vinyl/CDs) — https://www.discogs.com/settings/developers ===
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=RetailArbitrageTool/0.1 (+https://example.com/contact)
DISCOGS_CURRENCY=EUR

# === eBay official API (https://developer.ebay.com) ===
# Leave blank to run in MOCK valuation mode. For NL, comp against Germany:
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_ENV=production            # production | sandbox

# === Alerting (enable one or more) ===
DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
